# Copia in .env
# La voce di O.S.C.A.R.: ElevenLabs se c'è la chiave (elevenlabs.io → MCP e API → Chiavi API, basta «Text to Speech»),
# altrimenti quella del Mac. Le voci della Voice Library col piano Free l'API le rifiuta (402), e parla il Mac.
ELEVENLABS_API_KEY=
# Vuoto = Warm Agent Voice (AIJ0ViCZ83NSXLNIERjD), scelta di Tony del 28/11 dopo Daniel (cYUwsivXsYhRnPTjXRI4) e Vikram (9375G6zswFk7v9bKTVQF)
ELEVENLABS_VOICE_ID=
# Vuoto = eleven_flash_v2_5: 0,17–0,29 s a frase (28/11), circa 0,5 crediti a carattere. eleven_v4_turbo costa uguale,
# è più espressivo e ci mette 0,28–1,01 s, più lungo con la frase
ELEVENLABS_MODEL=
# Voce del Mac, anche di riserva quando ElevenLabs rifiuta (crediti, chiave, piano). Vuoto = la voce di sistema scelta
# nelle Impostazioni (anche Siri), se è italiana
OSCAR_MAC_VOICE=
# claude-opus-5-5 (predefinito dal 27/11) oppure claude-sonnet-5-5, più svelto a parlare: prima parola 0,7 s contro 2,1
OSCAR_MODEL=claude-opus-5-5
# low, medium, high, xhigh, max; default = l'effort di Claude Code. Più alto pensa di più e tace di più prima di parlare:
# Sonnet 5.5 il 12/11 (prove/latenza.mjs) dice la prima parola in 0,6–0,7 s a low, 0,8–1,0 s a high, 8,4 s a max.
# OSCAR_EFFORT vale per la voce (predefinito low); OSCAR_EFFORT_PENSA per i compiti annunciati con [[pensa]] e per la memoria (predefinito high)
OSCAR_EFFORT=low
OSCAR_EFFORT_PENSA=high
OSCAR_PORT=4321
# Solo per le prove, di solito vuoto. Una cartella dove vive un O.S.C.A.R. di prova: il cervello ci lavora (non tocca la memoria vera),
# il server ci scrive conversazione, mcp.json, ologramma e ascolto.log, e le cartelle dei documenti sono le sue sottocartelle
# (Desktop, Documents, Downloads…). Le variabili date a mano, per esempio OSCAR_CERVELLO=/tmp/prova OSCAR_PORT=4422 node server.mjs, vincono su questo file
OSCAR_CERVELLO=
