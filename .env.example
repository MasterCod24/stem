# Copia in .env (oppure lascia che lo crei avvia.command)
ELEVENLABS_API_KEY=
# Vuoto = Nexus sceglie da solo una voce maschile italiana del tuo account
ELEVENLABS_VOICE_ID=
# eleven_v4_turbo (veloce ed espressivo, mezzo credito a carattere) oppure eleven_v4, eleven_v3_conversational, eleven_multilingual_v2
ELEVENLABS_MODEL=eleven_v4_turbo
# Voce di riserva del Mac quando i crediti ElevenLabs finiscono. Vuoto = la voce di sistema scelta nelle Impostazioni (anche Siri), se è italiana
NEXUS_MAC_VOICE=
# GIF simpatiche: chiave gratuita da developers.giphy.com (le animazioni di Wikimedia non la richiedono)
GIPHY_API_KEY=
# claude-sonnet-5-5 (predefinito) oppure claude-opus-5-5; default = il modello di Claude Code
NEXUS_MODEL=claude-sonnet-5-5
# low, medium, high, xhigh, max; default = l'effort di Claude Code. Più alto pensa di più e tace di più prima di parlare:
# Sonnet 5.5 il 12/11 (prove/latenza.mjs) dice la prima parola in 0,6–0,7 s a low, 0,8–1,0 s a high, 8,4 s a max.
# NEXUS_EFFORT vale per la voce (predefinito low); NEXUS_EFFORT_PENSA per i compiti annunciati con [[pensa]] e per la memoria (predefinito high)
NEXUS_EFFORT=low
NEXUS_EFFORT_PENSA=high
NEXUS_PORT=4321
# Solo per le prove, di solito vuoto. Una cartella dove vive un Nexus di prova: il cervello ci lavora (non tocca la memoria vera),
# il server ci scrive conversazione, mcp.json, ologramma e ascolto.log, e le cartelle dei documenti sono le sue sottocartelle
# (Desktop, Documents, Downloads…). Le variabili date a mano, per esempio NEXUS_CERVELLO=/tmp/prova NEXUS_PORT=4422 node server.mjs, vincono su questo file
NEXUS_CERVELLO=
