# Copia in .env (oppure lascia che lo crei avvia.command)
ELEVENLABS_API_KEY=
# Vuoto = STEM sceglie da solo una voce maschile italiana del tuo account
ELEVENLABS_VOICE_ID=
# eleven_v4_turbo (veloce ed espressivo, mezzo credito a carattere) oppure eleven_v4, eleven_v3_conversational, eleven_multilingual_v2
ELEVENLABS_MODEL=eleven_v4_turbo
# Voce di riserva del Mac quando i crediti ElevenLabs finiscono. Vuoto = la voce di sistema scelta nelle Impostazioni (anche Siri), se è italiana
STEM_MAC_VOICE=
# GIF simpatiche: chiave gratuita da developers.giphy.com (le animazioni di Wikimedia non la richiedono)
GIPHY_API_KEY=
# claude-opus-5-5 (predefinito) ragiona più a fondo; sonnet dice la prima parola circa 1,5 s prima; default = il modello di Claude Code
STEM_MODEL=claude-opus-5-5
# low, medium (predefinito), high, xhigh, max; default = l'effort di Claude Code. Più alto pensa di più e tace di più prima di parlare
STEM_EFFORT=medium
STEM_PORT=4321
# Solo per le prove, di solito vuoto. Una cartella dove vive uno STEM di prova: il cervello ci lavora (non tocca la memoria vera),
# il server ci scrive conversazione, mcp.json, ologramma e ascolto.log, e le cartelle dei documenti sono le sue sottocartelle
# (Desktop, Documents, Downloads…). Le variabili date a mano, per esempio STEM_CERVELLO=/tmp/prova STEM_PORT=4422 node server.mjs, vincono su questo file
STEM_CERVELLO=
